# ====================================================================
# FemCare Backend Configuration
# ====================================================================

# 1. Server Port
PORT=8000

# 2. Database Connection
# If left commented or empty, the backend automatically uses local SQLite:
# DATABASE_URL=sqlite:///./backend/femcare.db

# To connect to Supabase PostgreSQL:
# Go to your Supabase Project -> Project Settings -> Database -> Connection String (URI)
# Example:
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# 3. Supabase Direct API Credentials (Optional, for Supabase Python SDK client)
# SUPABASE_URL=https://[YOUR_PROJECT_REF].supabase.co
# SUPABASE_KEY=[YOUR_ANON_OR_SERVICE_ROLE_KEY]
